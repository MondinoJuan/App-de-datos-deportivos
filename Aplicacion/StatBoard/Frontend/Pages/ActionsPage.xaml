<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:model="clr-namespace:Frontend.Resources.DTOs"
             x:Class="Frontend.Pages.ActionsPage"
             Title="ActionsPage">
    <Grid
        RowDefinitions="Auto, Auto"
        RowSpacing="15"
        Margin="15" >

        <Button
            Grid.Row="0"
            Text="Nuevo jugador"
            Command="{Binding CrearPlayerCommand}"/>

        <Label
            Grid.Row="1"
            Text="Lista de jugadores"
            FontSize="Subtitle"
            FontAttributes="Bold"
            HorizontalOptions="Center"
            TextColor="#8308FF" />

        <ScrollView
            Grid.Row="2">

            <CollectionView
                ItemsSource="{Binding ListaPlayers}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout 
                        ItemSpacing="5"
                        Orientation="Vertical"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate
                        x:DataType="model:Player_Dto">
                        <Border 
                            Padding="10,5"
                            HorizontalOptions="Fill">
                            <Border.StrokeShape>
                                <RoundRectangle
                                    CornerRadius="5"/>
                            </Border.StrokeShape>

                            <Grid
                                RowDefinitions="Auto, Auto"
                                ColumnDefinitions="Auto, *">

                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Text="Nombre completo:"
                                    FontAttributes="Bold"/>
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="{Binding Name}"
                                    HorizontalOptions="End"/>

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Text="Numero:"
                                    FontAttributes="Bold"/>
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="{Binding Number}"
                                    HorizontalOptions="End"/>

                                <Label
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Padding="0, 15, 10, 5"
                                    Text="Editar"
                                    TextColor="Blue">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding BindingContext.EditarPlayerCommand, Source={x:RelativeSource AncestorType={x:Type ContentPage}}}"
                                            CommandParameter="{Binding}"/>
                                    </Label.GestureRecognizers>
                                </Label>

                                <Label
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Padding="10, 15, 0, 5"
                                    Text="Emilinar"
                                    TextColor="Red">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding BindingContext.BorrarPlayerCommand, Source={x:RelativeSource AncestorType={x:Type ContentPage}}}"
                                            CommandParameter="{Binding}"/>
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>

                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            
        </ScrollView>

    </Grid>
</ContentPage>