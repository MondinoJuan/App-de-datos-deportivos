<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Frontend.Resources.Components.SwitchHalf">
    <Grid HorizontalOptions="Center" VerticalOptions="Center">
        <Grid 
            WidthRequest="60" 
            HeightRequest="30" 
            BackgroundColor="#e8e8e8" 
            Padding="2"
            HorizontalOptions="Center" 
            VerticalOptions="Center">
            <!-- Círculos decorativos -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0" WidthRequest="5" HeightRequest="5" Fill="LightGray" />
                <Ellipse Grid.Column="1" WidthRequest="5" HeightRequest="5" Fill="LightGray" />
                <Ellipse Grid.Column="2" WidthRequest="5" HeightRequest="5" Fill="LightGray" />
            </Grid>

            <!-- Toggle principal -->
            <Switch x:Name="CustomSwitch"
                    OnColor="#f3b519"
                    ThumbColor="White"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Toggled="OnCustomToggleChanged"/>
        </Grid>
    </Grid>
</ContentView>
