<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Frontend.Resources.Components.PlayerCircle"
             x:Name="Root">

    <Grid 
        HorizontalOptions="Fill"
        VerticalOptions="Fill">

        <!-- Círculo flexible -->
        <Border 
            Stroke="DarkBlue"
            BackgroundColor="LightBlue"
            StrokeThickness="2"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            StrokeShape="Ellipse"
            WidthRequest="{Binding CircleSize, Source={x:Reference Root}}"
            HeightRequest="{Binding CircleSize, Source={x:Reference Root}}"/>

        <!-- Contenido dentro del círculo -->
        <VerticalStackLayout 
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Spacing="2">
            
            <Label 
                Text="{Binding Number}"
                FontSize="{Binding NumberFontSize, Source={x:Reference Root}}"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="DarkBlue"/>

            <Label 
                Text="{Binding Name}"
                FontSize="{Binding NameFontSize, Source={x:Reference Root}}"
                HorizontalOptions="Center"
                TextColor="DarkGray"/>
        </VerticalStackLayout>

    </Grid>
</ContentView>
